{
    "name": "linchpin/coding-standards",
    "description": "Linchpin Coding Standards",
    "type": "phpcodesniffer-standard",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.0",
        "wp-coding-standards/wpcs": "^3.3.0",
        "automattic/vipwpcs": "^3.0.1",
        "fig-r/psr2r-sniffer": "^2.0.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2.0",
        "squizlabs/php_codesniffer": "^3.13.5",
        "phpcompatibility/phpcompatibility-wp": "2.1.8",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "php-parallel-lint/php-console-highlighter": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Linchpin\\": "Linchpin"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "scripts": {
        "test": "phpunit",
        "check-branch-cs": "Linchpin\\Composer\\Actions::check_branch_cs",
        "check-staged-cs": "Linchpin\\Composer\\Actions::check_staged_cs"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
