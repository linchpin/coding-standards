{
	"name": "linchpin/coding-standards",
	"description": "Linchpin Coding Standards",
	"type": "phpcodesniffer-standard",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.0",
		"wp-coding-standards/wpcs": "^3.3.0",
		"automattic/vipwpcs": "^3.0.1",
		"fig-r/psr2r-sniffer": "^2.0.0",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.2.0",
		"squizlabs/php_codesniffer": "^4.0.0",
		"phpcompatibility/phpcompatibility-wp": "2.1.8"
	},
	"autoload": {
		"psr-4": {
			"Linchpin\\": "Linchpin"
		}
	},
	"require-dev": {
		"phpunit/phpunit": "^13.0"
	},
	"scripts": {
		"test": "phpunit"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
